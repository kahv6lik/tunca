# Gezegen CRM — dağıtım ayarları
# Bu dosyayı deploy.env olarak kopyalayıp doldurun:  cp deploy/deploy.env.example deploy.env

# Alan adınız (DNS A kaydı sunucunuzun IP'sine yönlenmiş olmalı)
DOMAIN=crm.sirketiniz.com

# Let's Encrypt bildirimleri için e-posta
LETSENCRYPT_EMAIL=info@sirketiniz.com

# Oturum imzalama anahtarı.
# Boş bırakırsanız deploy.sh otomatik güçlü bir anahtar üretir ve buraya yazar.
AUTH_SECRET=

# İlk yönetici kullanıcısı (ilk kurulumda oluşturulur)
# NOT: Boşluk veya özel karakter içeren değerleri çift tırnak içine alın.
ADMIN_EMAIL=admin@gezegen.com
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Sistem Yöneticisi"

# Sertifika testleri için 1 yapın (Let's Encrypt staging — rate limit'e takılmamak için).
# Gerçek sertifika için 0 bırakın.
STAGING=0
