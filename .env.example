# Veritabanı bağlantısı (PostgreSQL — Faz 2'den itibaren)
# Yerel geliştirme için:
DATABASE_URL="postgresql://gezegen:gezegen@localhost:5432/gezegen_dev?schema=public"

# Oturum (JWT) imzalama anahtarı — üretimde MUTLAKA değiştirin.
# Güçlü bir değer üretmek için: openssl rand -base64 32
AUTH_SECRET="degistirin-bu-cok-gizli-bir-anahtar-olmali-32char"

