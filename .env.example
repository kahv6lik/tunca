# Veritabanı bağlantısı (PostgreSQL — Faz 2'den itibaren)
# Yerel geliştirme için:
DATABASE_URL="postgresql://gezegen:gezegen@localhost:5432/gezegen_dev?schema=public"

# Oturum (JWT) imzalama anahtarı — üretimde MUTLAKA değiştirin.
# Güçlü bir değer üretmek için: openssl rand -base64 32
AUTH_SECRET="degistirin-bu-cok-gizli-bir-anahtar-olmali-32char"

# Eski SQLite veritabanından veri taşıyacaksanız (tek seferlik):
# ESKI_SQLITE="file:./prisma/prod.db"

# Zamanlanmış işler (Faz 8) — /api/gorevler uç noktasını koruyan paylaşımlı giz.
# TANIMSIZSA UÇ NOKTA KAPALIDIR. Üretimde: openssl rand -hex 32
GOREV_ANAHTARI=

# Bildirim e-postalarındaki bağlantıların önüne eklenir.
UYGULAMA_ADRESI=http://localhost:3000

# ── Saha çalışması (Faz 17) ────────────────────────────────────────────────
# Dosya eklerinin saklandığı dizin. Üretimde Docker volume'üne bağlanır
# (docker-compose: gezegen-dosya). Boşsa ./veri/dosya kullanılır.
DOSYA_DIZIN=

# Adresten koordinat üretimi (geocoding). TANIMSIZSA ÖZELLİK KAPALIDIR:
# koordinat elle girilir, sessizce ücretli çağrı yapılmaz. Google Cloud
# konsolunda GÜNLÜK İSTEK SINIRI tanımlayın.
GOOGLE_MAPS_API_KEY=

# ── AI özellikleri (Faz 21) — İSTEĞE BAĞLI ──
# Tanımsızsa AI KAPALIDIR: skorlama ve kural tabanlı sorgu çalışmaya devam
# eder, yalnızca "paragraf hâline getir" ve model destekli sorgu devre dışı
# kalır. Ayrıca her kiracının kendi açma/kapama ayarı vardır (varsayılan
# KAPALI) — anahtar tanımlı olması tek başına yetmez.
ANTHROPIC_API_KEY=
# Varsayılan: claude-sonnet-4-5
AI_MODEL=
