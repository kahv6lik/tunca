// Gezegen CRM — veri modeli
//
// PostgreSQL (Faz 2). Enum yerine String alanlar + `src/lib/constants.ts`
// içindeki sabitler kullanılır; bu tercih SQLite döneminden kalmadır ve
// kiracıya özel durum değerlerini (Faz 11) kolaylaştırdığı için korunmuştur.
//
// ÇOK KİRACILILIK (Faz 1):
// Tenant dışındaki her model `tenantId` taşır ve tüm indekslerde `tenantId`
// ilk sütundur. Sorgular `src/lib/tenant-db.ts` üzerinden yapılır; o katman
// `tenantId` filtresini kendiliğinden uygular.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kiracı = hizmet verilen müşteri şirketi.
// Kiracılar birbirlerinin verisini ve varlığını göremez.
model Tenant {
  id    String @id @default(cuid())
  ad    String // müşteri şirketinin adı
  slug  String @unique // giriş ekranındaki kiracı kodu / alt alan adı
  durum String @default("aktif") // "aktif" | "askida" | "pasif"

  // İletişim (admin panelde müşteri kartı)
  iletisimAd    String?
  iletisimEmail String?
  iletisimTel   String?
  notlar        String?

  // Paket ve limitler (B4)
  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Markalama (B7)
  logoUrl String?
  anaRenk String? // "#6366f1" gibi
  altAlan String? @unique // "musteri" → musteri.crm.com

  // ── Güvenlik ve KVKK politikaları (Faz 12) ──
  // Kuruluş 2FA'yı zorunlu kılabilir: açıkken kurulumu olmayan kullanıcı
  // girişten sonra doğrudan kurulum ekranına yönlendirilir.
  ikiFaktorZorunlu Boolean @default(false)
  // Veri saklama süresi (gün, 0 = süresiz): denetim günlüğü ve e-posta
  // kayıtları bu süreden eskiyse zamanlanmış iş tarafından silinir (F7).
  veriSaklamaGun   Int     @default(0)
  // Oturum ömrü (gün) — kuruluş kendi politikasını belirler.
  oturumOmruGun    Int     @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kullanicilar     User[]
  firmalar         Firma[]
  yatirimlar       YatirimDestegi[]
  egitimler        Egitim[]
  hizmetler        Hizmet[]
  gruplar          Grup[]
  uyelikler        KullaniciGrup[]
  denetim          DenetimKaydi[]
  davetler         Davet[]
  kisiler          Kisi[]
  asamalar         Asama[]
  firsatlar        Firsat[]
  aktiviteler      Aktivite[]
  leadler          Lead[]
  teklifler        Teklif[]
  teklifKalemleri  TeklifKalemi[]
  Bildirim         Bildirim[]
  BildirimTercihi  BildirimTercihi[]
  EpostaAyari      EpostaAyari[]
  EpostaKuyrugu    EpostaKuyrugu[]
  EpostaKaydi      EpostaKaydi[]
  IsAkisi          IsAkisi[]
  IsAkisiCalismasi IsAkisiCalismasi[]
  PanoTercihi      PanoTercihi[]
  KayitliGorunum   KayitliGorunum[]
  Yedek            Yedek[]
  OzelAlan         OzelAlan[]
  OzelAlanDeger    OzelAlanDeger[]
  Oturum           Oturum[]
  SifreSifirlama   SifreSifirlama[]
  FirmaNoSayac     FirmaNoSayac?
  Urun             Urun[]
  Paket            Paket[]
  PaketKalemi      PaketKalemi[]
  Kampanya         Kampanya[]
  KampanyaUrun     KampanyaUrun[]
  KampanyaPaket    KampanyaPaket[]
  KampanyaFirma    KampanyaFirma[]
  KampanyaKullanim KampanyaKullanim[]
  StokHareketi     StokHareketi[]
  Siparis          Siparis[]
  SiparisKalemi    SiparisKalemi[]
  Sevkiyat         Sevkiyat[]
  BelgeSayac       BelgeSayac[]

  @@index([durum])
}

// Sisteme giriş yapan kullanıcılar (ekip üyeleri)
model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  name      String
  password  String // bcrypt hash
  // Roller ve izin matrisi: src/lib/yetki.ts
  role      String   @default("uye") // platform_admin | tenant_admin | uye | salt_okunur
  durum     String   @default("aktif") // "aktif" | "pasif"
  createdAt DateTime @default(now())

  // ── Hesap güvenliği (Faz 12) ──
  sifreGuncellendi DateTime? // son şifre değişikliği (politika ve denetim)
  // TOTP sırrı AES-256-GCM ile şifreli saklanır (sifreleme.ts) — veritabanını
  // okuyan biri ikinci faktörü taklit edememelidir.
  ikiFaktorSir     String?
  ikiFaktorAktif   Boolean   @default(false)
  // Yedek kodlar bcrypt ÖZETİ olarak saklanır; kod bir kez kullanılır ve
  // listeden düşer. Açık saklamak, 2FA'yı ikinci bir parolaya çevirirdi.
  yedekKodlar      String[]  @default([])
  // Hız sınırlama sayaçları — yalnızca giriş güvenliği kapısı yazar.
  basarisizGiris   Int       @default(0)
  kilitBitis       DateTime?
  // KVKK açık rıza kaydı (F7): ne zaman, hangi metin sürümü onaylandı.
  kvkkOnayTarihi   DateTime?
  kvkkSurum        String?

  gruplar   KullaniciGrup[]
  oturumlar Oturum[]

  // E-posta yalnızca kiracı içinde benzersiz; farklı kiracılarda aynı e-posta olabilir.
  @@unique([tenantId, email])
  @@index([email])
}

// Müşteriye bağlı firmalar
model Firma {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Değiştirilemez firma numarası (Faz 13 / H1): "A0001" … "Z9999".
  // Kiracı BAŞINA sayılır; üretimi FirmaNoSayac satırından atomik alınır.
  // Faz 13 öncesi kayıtlar migration'da numaralandığı için opsiyoneldir;
  // yeni kayıtlarda her zaman doludur.
  firmaNo   String?
  ad        String // firma unvanı
  vergiNo   String? // vergi numarası
  sektor    String? // sektör
  il        String? // il / şehir
  ilce      String?
  yetkiliAd String? // yetkili kişi
  telefon   String?
  email     String?
  adres     String?
  durum     String   @default("aktif") // "aktif" | "pasif"
  notlar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  yatirimlar       YatirimDestegi[]
  egitimler        Egitim[]
  hizmetler        Hizmet[]
  kisiler          Kisi[]
  firsatlar        Firsat[]
  aktiviteler      Aktivite[]
  leadler          Lead[]
  teklifler        Teklif[]
  ozelDegerler     OzelAlanDeger[]
  Paket            Paket[]
  KampanyaFirma    KampanyaFirma[]
  KampanyaKullanim KampanyaKullanim[]
  Siparis          Siparis[]

  @@unique([tenantId, firmaNo])
  @@index([tenantId, ad])
  @@index([tenantId, il])
  @@index([tenantId, sektor])
  @@index([tenantId, durum])
  @@index([tenantId, createdAt])
}

// Firmalara verilen yatırım destekleri
model YatirimDestegi {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId    String
  firma      Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  baslik     String
  tur        String? // hibe, kredi, teşvik vb.
  tutar      Float    @default(0)
  paraBirimi String   @default("TRY")
  tarih      DateTime @default(now())
  durum      String   @default("basvuruldu") // basvuruldu | onaylandi | reddedildi | tamamlandi
  aciklama   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, tarih])
}

// Firmalara verilen eğitimler
model Egitim {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId   String
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  baslik    String
  konu      String?
  egitmen   String?
  tarih     DateTime @default(now())
  sureSaat  Float    @default(0)
  katilimci Int      @default(0)
  durum     String   @default("planlandi") // planlandi | tamamlandi | iptal
  notlar    String?
  createdAt DateTime @default(now())

  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, tarih])
}

// Firmalara sunulan hizmetler
model Hizmet {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId   String
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  baslik    String
  tur       String? // danışmanlık, denetim, raporlama vb.
  tarih     DateTime @default(now())
  durum     String   @default("devam") // devam | tamamlandi | iptal
  aciklama  String?
  createdAt DateTime @default(now())

  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, tarih])
}

// ── Faz 4: Yetkilendirme ve denetim ────────────────────────────────────────

// Kullanıcı grubu — bir kiracı içinde izinleri toplu atamak için.
// Etkin izin = rolün izinleri ∪ üye olunan grupların izinleri.
model Grup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  aciklama  String?
  izinler   String[] // "firma.duzenle" gibi izin anahtarları (src/lib/yetki.ts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uyeler KullaniciGrup[]

  @@unique([tenantId, ad])
  @@index([tenantId, ad])
}

// Kullanıcı ↔ grup üyeliği
model KullaniciGrup {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  grupId   String
  grup     Grup   @relation(fields: [grupId], references: [id], onDelete: Cascade)

  @@id([userId, grupId])
  @@index([tenantId, userId])
  @@index([tenantId, grupId])
}

// Denetim günlüğü — kim, ne zaman, hangi kaydı değiştirdi.
// Uygulama üzerinden DEĞİŞTİRİLEMEZ ve SİLİNEMEZ; yalnızca yazılır ve okunur.
model DenetimKaydi {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId    String?
  kullaniciEmail String // kullanıcı silinse bile kim olduğu kalsın
  islem          String // "olustur" | "guncelle" | "sil"
  varlik         String // "Firma" | "YatirimDestegi" | "Egitim" | "Hizmet" | "Grup" | "User"
  varlikId       String
  ozet           String? // insan okuyabilir kısa açıklama
  eski           Json? // değişiklik öncesi alanlar
  yeni           Json? // değişiklik sonrası alanlar
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, varlik, varlikId])
  @@index([tenantId, kullaniciId])
}

// ── Faz 5: Admin panel ─────────────────────────────────────────────────────

// Abonelik paketi — kiracı başına limitler ve açık modüller.
// Kiracıya ait DEĞİLDİR: platform genelinde tanımlanır, kiracılar atanır.
model Plan {
  id              String   @id @default(cuid())
  ad              String   @unique
  aciklama        String?
  kullaniciLimiti Int      @default(0) // 0 = sınırsız
  firmaLimiti     Int      @default(0) // 0 = sınırsız
  moduller        String[] // "firma" | "yatirim" | "egitim" | "hizmet" | "rapor"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kiracilar Tenant[]
}

// Kullanıcı daveti (B3) — e-posta ile gönderilen tek kullanımlık bağlantı.
// Token'ın kendisi saklanmaz; yalnızca özeti (hash) tutulur.
model Davet {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String
  ad             String
  rol            String    @default("uye")
  tokenOzeti     String    @unique // sha256(token)
  sonKullanma    DateTime
  kullanildi     DateTime?
  olusturanEmail String
  createdAt      DateTime  @default(now())

  @@index([tenantId, email])
  @@index([tenantId, createdAt])
}

// ── Faz 6: Satış çekirdeği ─────────────────────────────────────────────────

// Kişi (Contact) — firmadaki muhatap. Bir firmanın birden çok kişisi olur.
// `Firma.yetkiliAd` alanı Faz 6 migration'ında buraya taşındı; alan geriye
// dönük uyumluluk için duruyor ama arayüzde artık kişi kaydı kullanılır.
model Kisi {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId   String
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  ad        String
  unvan     String? // görev / pozisyon (serbest metin)
  // Departman SABİT listeden seçilir (src/lib/constants.ts → DEPARTMANLAR).
  // Serbest metin olsaydı aynı departman üç farklı yazımla kaydolur ve
  // gruplama/raporlama anlamsızlaşırdı.
  departman String?
  telefon   String?
  email     String?
  // Firmanın birincil muhatabı. Firma başına en fazla bir tane olur; kural
  // uygulama katmanında (kisiler/actions.ts) zorlanır.
  birincil  Boolean  @default(false)
  notlar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firsatlar    Firsat[]
  aktiviteler  Aktivite[]
  ozelDegerler OzelAlanDeger[]
  Siparis      Siparis[]

  @@index([tenantId, firmaId])
  @@index([tenantId, ad])
  @@index([tenantId, email])
}

// Satış hattı aşaması — KİRACIYA ÖZELDİR. Her kiracı kendi hattını kurar.
// `sira` kanban'daki soldan sağa sıralamayı verir.
model Asama {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  sira      Int      @default(0)
  olasilik  Int      @default(0) // %0-100, fırsata varsayılan olarak kopyalanır
  renk      String? // "#6366f1" — kanban sütun rengi
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firsatlar Firsat[]

  @@unique([tenantId, ad])
  @@index([tenantId, sira])
}

// Fırsat / Anlaşma (Deal) — satış hattındaki bir iş.
//
// `durum` ile `asamaId` bilinçli olarak AYRIDIR: aşama hattaki yeri, durum ise
// sonucu anlatır. Kazanılan/kaybedilen bir fırsat son aşamasında kalır ama
// kanban'ın açık sütunlarından düşer.
model Firsat {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId       String
  firma         Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kisiId        String?
  kisi          Kisi?     @relation(fields: [kisiId], references: [id], onDelete: SetNull)
  asamaId       String
  asama         Asama     @relation(fields: [asamaId], references: [id], onDelete: Restrict)
  baslik        String
  tutar         Float     @default(0)
  paraBirimi    String    @default("TRY")
  olasilik      Int       @default(0) // %0-100
  kapanisTarihi DateTime?
  // Sorumlu kullanıcı. Kullanıcı silinirse fırsat sahipsiz kalır, silinmez.
  sorumluId     String?
  durum         String    @default("acik") // acik | kazanildi | kaybedildi
  kapanisSebebi String? // kaybedildiyse neden
  aciklama      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  aktiviteler  Aktivite[]
  teklifler    Teklif[]
  ozelDegerler OzelAlanDeger[]

  @@index([tenantId, asamaId])
  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, sorumluId])
  @@index([tenantId, kapanisTarihi])
}

// ── Faz 7: Satış derinleştirme ─────────────────────────────────────────────

// Aktivite / görev (C4) — arama, toplantı, not, görev, e-posta.
//
// Bilinçli olarak TEK model: "not" ile "görev" arasındaki fark bir alan
// (sonTarih/tamamlandi) meselesidir, ayrı tablo değil. Böylece firma
// timeline'ında (C6) tek sorguyla hepsi listelenir.
model Aktivite {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tur      String // arama | toplanti | not | gorev | eposta
  baslik   String
  aciklama String?

  // Bağlam — hepsi isteğe bağlıdır; bir aktivite yalnızca firmaya, ya da
  // firma + kişi + fırsata birden bağlanabilir.
  firmaId  String?
  firma    Firma?  @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kisiId   String?
  kisi     Kisi?   @relation(fields: [kisiId], references: [id], onDelete: SetNull)
  firsatId String?
  firsat   Firsat? @relation(fields: [firsatId], references: [id], onDelete: Cascade)

  // Görev alanları. `sonTarih` doluysa kayıt "yapılacak iş"tir.
  atananId   String?
  sonTarih   DateTime?
  tamamlandi DateTime? // doluysa tamamlanmış sayılır

  olusturanId    String?
  olusturanEmail String? // kullanıcı silinse de kimin girdiği kalsın
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, firmaId])
  @@index([tenantId, firsatId])
  @@index([tenantId, atananId, sonTarih])
  @@index([tenantId, createdAt])
}

// Aday müşteri / Lead (C5).
//
// Lead, HENÜZ firma olmamış bir ilgidir. Nitelendiğinde tek işlemle firma +
// kişi (+ isteğe bağlı fırsat) kayıtlarına dönüşür; dönüşen lead silinmez,
// nereye dönüştüğü `donusen*` alanlarında saklanır — kaynak takibi
// (hangi kanal ne kadar iş getirdi) bu bağa dayanır.
model Lead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ad       String // aday kişi
  firmaAd  String? // henüz sistemde firma kaydı yok, serbest metin
  unvan    String?
  email    String?
  telefon  String?
  il       String?
  sektor   String?
  kaynak   String? // web, fuar, referans, telefon, sosyal medya…
  durum    String  @default("yeni") // yeni | iletisim | nitelikli | donusturuldu | elendi
  notlar   String?
  atananId String?

  // Dönüşüm izleri (SetNull: hedef kayıt silinse de lead kalır)
  donusenFirmaId  String?
  donusenFirma    Firma?    @relation(fields: [donusenFirmaId], references: [id], onDelete: SetNull)
  donusenKisiId   String?
  donusenFirsatId String?
  donusumTarihi   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, durum])
  @@index([tenantId, kaynak])
  @@index([tenantId, atananId])
  @@index([tenantId, createdAt])
}

// Teklif (C7) — fırsata bağlı, kalemli, revizyonlu.
//
// Revizyon yeni bir Teklif satırıdır ve `ustTeklifId` ile aslına bağlanır;
// eski sürüm DEĞİŞTİRİLMEZ. Gönderilmiş bir teklifin üzerine yazmak, "hangi
// rakamı görüştük?" sorusunu yanıtsız bırakırdı.
model Teklif {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firmaId  String
  firma    Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firsatId String?
  firsat   Firsat? @relation(fields: [firsatId], references: [id], onDelete: SetNull)
  kisiId   String?

  no     String // kiracı içinde benzersiz teklif numarası
  baslik String
  durum  String @default("taslak") // taslak | gonderildi | kabul | red | revizyon

  paraBirimi    String @default("TRY")
  indirimOrani  Float  @default(0) // % — ara toplam üzerinden
  kdvOrani      Float  @default(20) // %
  araToplam     Float  @default(0) // kalem toplamı (hesaplanır, saklanır)
  indirimTutari Float  @default(0)
  kdvTutari     Float  @default(0)
  toplam        Float  @default(0)

  gecerlilikTarihi DateTime?
  gonderimTarihi   DateTime?
  notlar           String?
  sartlar          String?

  // Revizyon zinciri
  revizyonNo  Int      @default(1)
  ustTeklifId String?
  ustTeklif   Teklif?  @relation("TeklifRevizyon", fields: [ustTeklifId], references: [id], onDelete: SetNull)
  revizyonlar Teklif[] @relation("TeklifRevizyon")

  olusturanEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kalemler TeklifKalemi[]
  Siparis  Siparis[]

  @@unique([tenantId, no])
  @@index([tenantId, firmaId])
  @@index([tenantId, firsatId])
  @@index([tenantId, durum])
  @@index([tenantId, createdAt])
}

// Teklif kalemi — satır bazlı tutar. Teklifle birlikte silinir.
model TeklifKalemi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teklifId String
  teklif   Teklif @relation(fields: [teklifId], references: [id], onDelete: Cascade)

  sira       Int    @default(0)
  aciklama   String
  miktar     Float  @default(1)
  birim      String @default("adet")
  birimFiyat Float  @default(0)
  tutar      Float  @default(0) // miktar × birimFiyat (hesaplanır, saklanır)

  @@index([tenantId, teklifId])
}

// ── Faz 8: Bildirim, otomasyon, e-posta, takvim ────────────────────────────

// Uygulama içi bildirim (D5).
//
// E-postadan AYRI tutulur: e-posta gönderilemese bile (SMTP tanımsız, sunucu
// erişilemez) kullanıcı olan biteni panelde görebilmelidir.
model Bildirim {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId String // bildirimin sahibi

  tur    String // gorev.atandi | gorev.yaklasti | firsat.asama | teklif.durum | ...
  baslik String
  mesaj  String?
  link   String? // tıklanınca gidilecek yol

  okundu    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, kullaniciId, okundu])
  @@index([tenantId, createdAt])
}

// Kullanıcı bildirim tercihi (D1).
//
// Kayıt YOKSA varsayılan geçerlidir (uygulama içi açık, e-posta açık); yani
// tercih tablosu yalnızca "varsayılandan sapma"yı tutar. Yeni bir bildirim
// türü eklendiğinde herkes için satır açmak gerekmez.
model BildirimTercihi {
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId String
  tur         String // bildirim türü anahtarı
  uygulama    Boolean @default(true)
  eposta      Boolean @default(true)

  @@id([kullaniciId, tur])
  @@index([tenantId, kullaniciId])
}

// Kiracının e-posta ayarları (D1 gönderim, D3 gelen kutusu).
//
// Parolalar AES-256-GCM ile şifreli saklanır (`src/lib/sifreleme.ts`);
// veritabanını okuyan biri müşterinin posta kutusuna erişememelidir.
model EpostaAyari {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Giden (SMTP)
  smtpHost      String?
  smtpPort      Int     @default(587)
  smtpGuvenli   Boolean @default(false) // true = 465/SSL, false = STARTTLS
  smtpKullanici String?
  smtpParola    String? // şifreli
  gonderenAd    String?
  gonderenAdres String?

  // Gelen (IMAP)
  imapHost      String?
  imapPort      Int       @default(993)
  imapKullanici String?
  imapParola    String? // şifreli
  imapKlasor    String    @default("INBOX")
  sonSenkron    DateTime?
  sonHata       String?

  aktif     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Giden e-posta kuyruğu ve kaydı (D1).
//
// Gönderim ANINDA denenmez: kayıt yazılır, zamanlanmış çalıştırıcı gönderir.
// Böylece SMTP yavaş ya da erişilemez olduğunda kullanıcının işlemi
// beklemez ve başarısız gönderim yeniden denenebilir.
model EpostaKuyrugu {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  alici String
  konu  String
  govde String
  tur   String? // hangi bildirim türünden doğdu

  durum          String    @default("bekliyor") // bekliyor | gonderildi | hata
  denemeSayisi   Int       @default(0)
  hata           String?
  gonderimZamani DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, durum])
  @@index([tenantId, createdAt])
}

// Senkronize edilen gelen e-posta (D3).
//
// Mesajın kendisi değil, ÖZETİ saklanır: kim, ne zaman, hangi konu. Gövde
// yalnızca ilgili kayda düşen aktivitede özet olarak durur. Amaç posta
// istemcisi olmak değil, yazışmanın CRM'de izini bırakmak.
model EpostaKaydi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mesajId  String // IMAP Message-ID — aynı posta iki kez işlenmesin
  yon      String   @default("gelen") // gelen | giden
  gonderen String
  alici    String
  konu     String
  ozet     String?
  tarih    DateTime

  // Eşleşme (bulunabildiyse)
  firmaId String?
  kisiId  String?

  createdAt DateTime @default(now())

  @@unique([tenantId, mesajId])
  @@index([tenantId, tarih])
  @@index([tenantId, firmaId])
}

// İş akışı kuralı (D2).
//
// "Tetikleyici olduğunda şu eylemleri yap." Kural KİRACIYA ÖZELDİR.
// Koşullar ve eylemler JSON olarak saklanır; her kural tipi için ayrı sütun
// açmak, yeni tetikleyici eklendiğinde şema değişikliği gerektirirdi.
model IsAkisi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ad       String
  aciklama String?
  aktif    Boolean @default(true)

  tetikleyici String // firsat.asamaDegisti | gorev.yaklasti | teklif.durumDegisti | firsat.beklemede
  kosullar    Json? // { asamaId, gunSayisi, durum, ... }
  eylemler    Json // [{ tur: "bildirim"|"eposta"|"gorev", ... }]

  sonCalisma    DateTime?
  calismaSayisi Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calismalar IsAkisiCalismasi[]

  @@unique([tenantId, ad])
  @@index([tenantId, aktif])
}

// İş akışı çalışma kaydı (D2) — neyin neden tetiklendiğinin izi.
model IsAkisiCalismasi {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isAkisiId String
  isAkisi   IsAkisi @relation(fields: [isAkisiId], references: [id], onDelete: Cascade)

  hedefTur  String? // Firsat | Aktivite | Teklif
  hedefId   String?
  sonuc     String // basarili | hata
  ozet      String?
  createdAt DateTime @default(now())

  @@index([tenantId, isAkisiId, createdAt])
}

// ── Faz 10: Kişiselleştirme ve süreklilik ──────────────────────────────────

// Kullanıcının Genel Bakış tercihi (E3).
//
// `kartlar` sıralı kart anahtarlarıdır; kayıt YOKSA varsayılan düzen
// geçerlidir (bildirim tercihlerindeki desenle aynı: tablo yalnızca
// varsayılandan sapmayı tutar).
model PanoTercihi {
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId String   @id
  kartlar     String[] // sıralı kart anahtarları (src/lib/pano-tanimlar.ts)
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// Kayıtlı görünüm (E4) — bir listenin adlandırılmış filtre hâli.
//
// `sorgu` ham querystring'dir ("ara=tekstil&durum=aktif&il=İzmir").
// Listeler zaten URL parametreleriyle filtrelendiği için görünüm = adlı bir
// URL'dir; her liste için ayrı şema gerekmez ve dışa aktarım da aynı
// parametreleri kullandığından görünümler orada da geçerlidir.
model KayitliGorunum {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId String // görünümün sahibi
  liste       String // "firmalar" | "firsatlar" | "adaylar" | ...
  ad          String
  sorgu       String // querystring
  // Paylaşılan görünüm kiracıdaki herkese görünür; yalnızca sahibi (veya
  // kuruluş yöneticisi) değiştirebilir/silebilir.
  paylasilan  Boolean @default(false)
  // Varsayılan görünüm: liste parametresiz açılınca uygulanır. Kişiseldir.
  varsayilan  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kullaniciId, liste, ad])
  @@index([tenantId, liste])
}

// Kiracı yedeği (E7).
//
// İçerik gzip'li JSON olarak SAKLANIR ve ayrıca dosya olarak İNDİRİLEBİLİR.
// Veritabanında durması "yanlışlıkla sildim" senaryosunu çözer; sunucunun
// kendisinin kaybı senaryosu için kullanıcı dosyayı indirir (gerçek yedek
// her zaman dışarıda tutulandır — bu, docs/DEPLOY.md'de de yazılıdır).
model Yedek {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tur            String  @default("elle") // elle | otomatik
  kayitSayisi    Int     @default(0)
  boyut          Int     @default(0) // gzip sonrası bayt
  surum          String? // yedeği üreten uygulama sürümü
  icerik         Bytes
  olusturanEmail String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ── Kiracıya özel alanlar (Faz 11 / E6) ─────────────────────────────────────
//
// Her kiracı; firma, kişi ve fırsat kayıtlarına kendi alanlarını ekler.
// Tip listesi src/lib/ozel-alan-tanimlar.ts içindedir (metin, sayı, tarih,
// seçim, onay). Değer her zaman String saklanır — tip yalnızca doğrulama ve
// gösterim içindir. Bu, constants.ts'teki "enum yerine String" tercihinin
// devamıdır.
model OzelAlan {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  varlik     String // "firma" | "kisi" | "firsat"
  ad         String
  tip        String   @default("metin")
  secenekler String[] @default([]) // yalnızca tip="secim" kullanır
  zorunlu    Boolean  @default(false)
  sira       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  degerler OzelAlanDeger[]

  @@unique([tenantId, varlik, ad])
  @@index([tenantId, varlik, sira])
}

// Özel alan değeri. Kayıt bağlantısı GERÇEK yabancı anahtardır (üç seçenekli
// sütundan tam biri dolu olur): kayıt silinince değerleri veritabanı düzeyinde
// cascade ile temizlenir — "yetim değer" sınıfı sorun baştan kapatılır.
model OzelAlanDeger {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  alanId String
  alan   OzelAlan @relation(fields: [alanId], references: [id], onDelete: Cascade)

  firmaId  String?
  firma    Firma?  @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kisiId   String?
  kisi     Kisi?   @relation(fields: [kisiId], references: [id], onDelete: Cascade)
  firsatId String?
  firsat   Firsat? @relation(fields: [firsatId], references: [id], onDelete: Cascade)

  deger String

  updatedAt DateTime @updatedAt

  // Kayıt başına alan başına tek değer (NULL'lar Postgres'te çakışmaz).
  @@unique([alanId, firmaId])
  @@unique([alanId, kisiId])
  @@unique([alanId, firsatId])
  @@index([tenantId, alanId, deger])
  @@index([firmaId])
  @@index([kisiId])
  @@index([firsatId])
}

// ── Hesap güvenliği ve KVKK (Faz 12 / F1-F4, F7) ────────────────────────────

// Sunucu tarafı oturum kaydı (F3).
//
// Oturum çerezi hâlâ JWT'dir, ama artık bir `jti` taşır ve o jti burada bir
// satıra karşılık gelir. Böylece oturum UZAKTAN SONLANDIRILABİLİR: JWT
// kendi başına iptal edilemez, sunucuda karşılığı olmayan jti reddedilir.
model Oturum {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jti         String   @unique
  cihaz       String? // User-Agent özeti ("Chrome · macOS")
  ip          String?
  sonGorulme  DateTime @default(now())
  sonKullanma DateTime
  createdAt   DateTime @default(now())

  @@index([tenantId, userId])
  @@index([sonKullanma])
}

// Şifre sıfırlama isteği (F1).
//
// Davet akışıyla aynı desen: token'ın KENDİSİ saklanmaz, yalnızca sha256
// özeti. Veritabanını okuyan biri kimsenin hesabını ele geçiremez.
model SifreSifirlama {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String

  tokenOzeti  String    @unique // sha256(token)
  sonKullanma DateTime
  kullanildi  DateTime?
  istekIp     String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([sonKullanma])
}

// Giriş denemesi günlüğü (F4) — hız sınırlama ve brute-force koruması.
//
// KİRACIYA BAĞLI DEĞİLDİR ve bu bilinçlidir: deneme, kimlik doğrulanmadan
// ÖNCE kaydedilir; o anda e-postanın hangi kiracıya ait olduğu (ya da var
// olup olmadığı) bilinmez ve bilinmemelidir. Erişim yalnızca giriş güvenliği
// kapısındandır (src/lib/giris-guvenlik.ts).
model GirisDenemesi {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  basarili  Boolean  @default(false)
  sebep     String? // "sifre" | "kilit" | "2fa" | "pasif"
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

// ── Firma numarası sayacı (Faz 13 / H1) ─────────────────────────────────────
//
// Kiracı başına TEK satır. Sıradaki numara buradan ATOMİK olarak alınır:
//   UPDATE ... SET sonSira = sonSira + 1 RETURNING sonSira
//
// "En büyük numarayı bul, bir ekle" yaklaşımı yarış koşuludur — aynı anda
// firma açan iki kullanıcı aynı numarayı okur. Sayaç, veritabanının satır
// kilidi sayesinde bu sorunu baştan kapatır.
model FirmaNoSayac {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sonSira Int @default(0) // 0 = henüz numara verilmedi

  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// TİCARİ ÇEKİRDEK (Faz 14) — ürün, paket, kampanya, stok
// ═══════════════════════════════════════════════════════════════════════════

// Ürün / hizmet kataloğu (T1).
//
// `stokTakibi` bilinçli bir bayraktır: danışmanlık gibi hizmet kalemlerinin
// stoğu yoktur ve onlar için bakiye tutmak anlamsız uyarılar üretirdi.
// Kapalıyken sipariş stok bakiyesine bakmaz.
model Urun {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kod        String // kiracı içinde tekil
  ad         String
  aciklama   String?
  kategori   String?
  birim      String  @default("adet")
  listeFiyat Float   @default(0)
  paraBirimi String  @default("TRY")
  kdvOrani   Float   @default(20)
  durum      String  @default("aktif") // "aktif" | "pasif"

  // ── Stok (T7, T8) ────────────────────────────────────────────────────────
  // `stokMiktar` hareketlerin ÖZETİDİR, gerçeğin kaynağı değil: doğruluk
  // StokHareketi defterindedir. Özet burada tutulur çünkü her liste
  // sorgusunda binlerce hareketi toplamak sürdürülebilir değildir.
  // Güncellemesi atomiktir (`UPDATE ... SET stokMiktar = stokMiktar + n`).
  stokTakibi Boolean @default(false)
  stokMiktar Float   @default(0)
  kritikStok Float   @default(0) // altına düşünce uyarı (0 = uyarma)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paketKalemleri  PaketKalemi[]
  kampanyaKapsam  KampanyaUrun[]
  stokHareketleri StokHareketi[]
  SiparisKalemi   SiparisKalemi[]

  @@unique([tenantId, kod])
  @@index([tenantId, durum, ad])
  @@index([tenantId, kategori])
}

// Müşteriye özel ürün paketi (T2).
//
// `firmaId` boşsa paket kiracı genelinde herkese açıktır; doluysa YALNIZCA o
// firmaya sunulur. Ortağın bulgusu "müşteriye özel paket" olduğu için bağ
// zorunlu değil, opsiyoneldir: aynı ekran iki ihtiyacı da karşılar.
model Paket {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId  String?
  firma    Firma?  @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  kod          String
  ad           String
  aciklama     String?
  paraBirimi   String  @default("TRY")
  // Sabit paket fiyatı (0 ve `sabitFiyat=false` ise kalemlerin toplamı).
  sabitFiyat   Boolean @default(false)
  fiyat        Float   @default(0)
  // Kalem toplamı üzerinden yüzde iskonto (sabitFiyat kapalıyken kullanılır).
  iskontoOrani Float   @default(0)
  durum        String  @default("aktif")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kalemler       PaketKalemi[]
  kampanyaKapsam KampanyaPaket[]
  SiparisKalemi  SiparisKalemi[]

  @@unique([tenantId, kod])
  @@index([tenantId, durum])
  @@index([tenantId, firmaId])
}

model PaketKalemi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paketId  String
  paket    Paket  @relation(fields: [paketId], references: [id], onDelete: Cascade)
  urunId   String
  urun     Urun   @relation(fields: [urunId], references: [id], onDelete: Restrict)

  miktar Float @default(1)
  sira   Int   @default(0)

  @@unique([paketId, urunId])
  @@index([tenantId, paketId])
}

// Kampanya (T3, T4).
//
// KOTA: `kota = 0` sınırsız demektir. Kalan hak `kota - kullanilan` ile
// hesaplanmaz — `kullanilan` sayacı veritabanında KOŞULLU ve ATOMİK
// artırılır (`UPDATE ... WHERE kota = 0 OR kullanilan + n <= kota`), yani
// aynı anda satış yapan iki temsilci son adedi birlikte satamaz.
model Kampanya {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kod      String
  ad       String
  aciklama String?
  tip      String  @default("yuzde") // constants.ts → KAMPANYA_TIP
  durum    String  @default("taslak") // taslak | aktif | duraklatildi | sonaerdi

  baslangic DateTime
  bitis     DateTime

  // İndirim kuralı — tipe göre okunur.
  deger Float @default(0) // yüzde ya da tutar
  alN   Int   @default(0) // "X alana Y bedava" için
  odeM  Int   @default(0)

  kota       Int @default(0) // 0 = sınırsız
  kullanilan Int @default(0)

  // Firma kapsamı: liste BOŞSA kampanya tüm firmalara açıktır.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  urunler       KampanyaUrun[]
  paketler      KampanyaPaket[]
  firmalar      KampanyaFirma[]
  kullanimlar   KampanyaKullanim[]
  SiparisKalemi SiparisKalemi[]

  @@unique([tenantId, kod])
  @@index([tenantId, durum, baslangic])
}

model KampanyaUrun {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kampanyaId String
  kampanya   Kampanya @relation(fields: [kampanyaId], references: [id], onDelete: Cascade)
  urunId     String
  urun       Urun     @relation(fields: [urunId], references: [id], onDelete: Cascade)

  @@unique([kampanyaId, urunId])
  @@index([tenantId, kampanyaId])
}

model KampanyaPaket {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kampanyaId String
  kampanya   Kampanya @relation(fields: [kampanyaId], references: [id], onDelete: Cascade)
  paketId    String
  paket      Paket    @relation(fields: [paketId], references: [id], onDelete: Cascade)

  @@unique([kampanyaId, paketId])
  @@index([tenantId, kampanyaId])
}

model KampanyaFirma {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kampanyaId String
  kampanya   Kampanya @relation(fields: [kampanyaId], references: [id], onDelete: Cascade)
  firmaId    String
  firma      Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@unique([kampanyaId, firmaId])
  @@index([tenantId, kampanyaId])
}

// Kampanya kullanım defteri (T4, T5).
//
// "Bu firma bu kampanyadan kaç kez faydalandı" sorusunun kaynağıdır ve
// kampanya raporunun tamamı buradan çıkar. Satır SİLİNMEZ; iptal edilen bir
// kullanım `iptal = true` ile işaretlenir ve kota iadesi ayrı bir işlemdir.
model KampanyaKullanim {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kampanyaId String
  kampanya   Kampanya @relation(fields: [kampanyaId], references: [id], onDelete: Cascade)
  firmaId    String
  firma      Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  adet          Int     @default(1)
  indirimTutari Float   @default(0)
  paraBirimi    String  @default("TRY")
  // Faz 15'te sipariş numarası buraya yazılır; şimdilik serbest referans.
  referans      String?
  iptal         Boolean @default(false)

  kullananId String?
  createdAt  DateTime @default(now())

  @@index([tenantId, kampanyaId, createdAt])
  @@index([tenantId, firmaId])
}

// Stok hareket defteri (T7).
//
// DEĞİŞTİRİLEMEZ: bakiye hareketlerin toplamıdır, elle yazılan bir sayı
// değildir. Yanlış bir hareket silinmez, ters yönlü bir düzeltme hareketiyle
// kapatılır — depo sayımıyla sistem arasındaki fark ancak böyle izlenebilir.
model StokHareketi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  urunId   String
  urun     Urun   @relation(fields: [urunId], references: [id], onDelete: Cascade)

  tur           String // constants.ts → STOK_HAREKET_TUR
  miktar        Float // İŞARETLİ: giriş +, çıkış −
  sonrakiBakiye Float   @default(0) // hareketten sonraki bakiye (denetim izi)
  aciklama      String?
  referans      String? // sevkiyat/sipariş no (Faz 15)

  kullaniciId String?
  createdAt   DateTime @default(now())

  @@index([tenantId, urunId, createdAt])
  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// SİPARİŞ, ONAY VE SEVKİYAT (Faz 15)
// ═══════════════════════════════════════════════════════════════════════════

// Sipariş (S1).
//
// AKIŞIN SÖZÜ: satış personelinin girdiği sipariş "onay bekliyor" durumunda
// açılır ve ONAYLANMADAN sevkiyata düşmez. Sevkiyat kaydı yalnızca onaylanmış
// siparişten doğar; bu kural `siparis.ts` içinde tek kapıdan geçer ve testle
// sabitlenmiştir.
//
// Tutarlar SUNUCUDA hesaplanır ve saklanır (teklifteki desen): formdaki
// toplam yalnızca önizlemedir. Onaylanmış bir siparişin rakamı, o gün
// müşteriye söylenen rakamdır — sonradan fiyat listesi değişse bile
// değişmemelidir.
model Siparis {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  no      String
  firmaId String
  firma   Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kisiId  String?
  kisi    Kisi?   @relation(fields: [kisiId], references: [id], onDelete: SetNull)

  // Tekliften doğan sipariş kaynağını taşır (S2). Teklif silinse bile
  // sipariş ayakta kalır: satış gerçekleşmiştir.
  teklifId String?
  teklif   Teklif? @relation(fields: [teklifId], references: [id], onDelete: SetNull)

  durum String @default("onaybekliyor") // constants.ts → SIPARIS_DURUM

  araToplam     Float  @default(0)
  indirimTutari Float  @default(0)
  kdvTutari     Float  @default(0)
  toplam        Float  @default(0)
  paraBirimi    String @default("TRY")

  notlar String?

  // ── Onay akışı (S3) ──
  olusturanId String?
  onaylayanId String?
  onayTarihi  DateTime?
  redSebebi   String?

  // Onayda düşülen stok/kota geri alınabilsin diye işaretlenir: iptal
  // edilen bir sipariş, düşülmemiş stoğu iade etmeye kalkmamalıdır.
  stokDusuldu Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kalemler    SiparisKalemi[]
  sevkiyatlar Sevkiyat[]

  @@unique([tenantId, no])
  @@index([tenantId, durum, createdAt])
  @@index([tenantId, firmaId])
}

model SiparisKalemi {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siparisId String
  siparis   Siparis @relation(fields: [siparisId], references: [id], onDelete: Cascade)

  // Ürün silinse bile satır kalır: sipariş geçmişi bozulmamalı. Bu yüzden
  // açıklama ve fiyat satırın KENDİSİNDE saklanır, ürüne bakılarak
  // hesaplanmaz (teklif kalemindeki desen).
  urunId  String?
  urun    Urun?   @relation(fields: [urunId], references: [id], onDelete: SetNull)
  paketId String?
  paket   Paket?  @relation(fields: [paketId], references: [id], onDelete: SetNull)

  sira         Int    @default(0)
  aciklama     String
  miktar       Float  @default(1)
  birim        String @default("adet")
  birimFiyat   Float  @default(0)
  iskontoOrani Float  @default(0)
  kdvOrani     Float  @default(20)

  // Uygulanan kampanya ve indirimi satır bazında saklanır: "bu satıra neden
  // bu fiyat verildi?" sorusu sonradan da yanıtlanabilmeli.
  kampanyaId    String?
  kampanya      Kampanya? @relation(fields: [kampanyaId], references: [id], onDelete: SetNull)
  indirimTutari Float     @default(0)
  tutar         Float     @default(0) // KDV hariç net

  @@index([tenantId, siparisId])
}

// Sevkiyat (S4).
//
// YALNIZCA ONAYLANMIŞ siparişten doğar. Bir siparişin birden çok sevkiyatı
// olabilir (kısmi sevkiyat); bu yüzden ayrı bir tablodur.
model Sevkiyat {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siparisId String
  siparis   Siparis @relation(fields: [siparisId], references: [id], onDelete: Cascade)

  no       String
  durum    String  @default("hazirlaniyor") // constants.ts → SEVKIYAT_DURUM
  tasiyici String?
  takipNo  String?
  adres    String?

  sevkTarihi   DateTime?
  teslimTarihi DateTime?
  notlar       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, no])
  @@index([tenantId, durum, createdAt])
  @@index([tenantId, siparisId])
}

// Sipariş ve sevkiyat numarası sayacı (Faz 15).
//
// Firma numarasındaki (Faz 13) atomik sayaç deseni: "en büyüğü bul + 1"
// yarış koşuludur. `tur` alanı sayacı ayırır ("siparis" | "sevkiyat") ve
// numara YIL bazında sıfırlanır — muhasebe alışkanlığı böyledir.
model BelgeSayac {
  tenantId String
  tur      String
  yil      Int

  sonSira   Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, tur, yil])
}
