// Gezegen CRM — veri modeli
//
// PostgreSQL (Faz 2). Enum yerine String alanlar + `src/lib/constants.ts`
// içindeki sabitler kullanılır; bu tercih SQLite döneminden kalmadır ve
// kiracıya özel durum değerlerini (Faz 11) kolaylaştırdığı için korunmuştur.
//
// ÇOK KİRACILILIK (Faz 1):
// Tenant dışındaki her model `tenantId` taşır ve tüm indekslerde `tenantId`
// ilk sütundur. Sorgular `src/lib/tenant-db.ts` üzerinden yapılır; o katman
// `tenantId` filtresini kendiliğinden uygular.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kiracı = hizmet verilen müşteri şirketi.
// Kiracılar birbirlerinin verisini ve varlığını göremez.
model Tenant {
  id    String @id @default(cuid())
  ad    String // müşteri şirketinin adı
  slug  String @unique // giriş ekranındaki kiracı kodu / alt alan adı
  durum String @default("aktif") // "aktif" | "askida" | "pasif"

  // İletişim (admin panelde müşteri kartı)
  iletisimAd    String?
  iletisimEmail String?
  iletisimTel   String?
  notlar        String?

  // Paket ve limitler (B4)
  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Markalama (B7)
  logoUrl String?
  anaRenk String? // "#6366f1" gibi
  altAlan String? @unique // "musteri" → musteri.crm.com

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kullanicilar     User[]
  firmalar         Firma[]
  yatirimlar       YatirimDestegi[]
  egitimler        Egitim[]
  hizmetler        Hizmet[]
  gruplar          Grup[]
  uyelikler        KullaniciGrup[]
  denetim          DenetimKaydi[]
  davetler         Davet[]
  kisiler          Kisi[]
  asamalar         Asama[]
  firsatlar        Firsat[]
  aktiviteler      Aktivite[]
  leadler          Lead[]
  teklifler        Teklif[]
  teklifKalemleri  TeklifKalemi[]
  Bildirim         Bildirim[]
  BildirimTercihi  BildirimTercihi[]
  EpostaAyari      EpostaAyari[]
  EpostaKuyrugu    EpostaKuyrugu[]
  EpostaKaydi      EpostaKaydi[]
  IsAkisi          IsAkisi[]
  IsAkisiCalismasi IsAkisiCalismasi[]

  @@index([durum])
}

// Sisteme giriş yapan kullanıcılar (ekip üyeleri)
model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  name      String
  password  String // bcrypt hash
  // Roller ve izin matrisi: src/lib/yetki.ts
  role      String   @default("uye") // platform_admin | tenant_admin | uye | salt_okunur
  durum     String   @default("aktif") // "aktif" | "pasif"
  createdAt DateTime @default(now())

  gruplar KullaniciGrup[]

  // E-posta yalnızca kiracı içinde benzersiz; farklı kiracılarda aynı e-posta olabilir.
  @@unique([tenantId, email])
  @@index([email])
}

// Müşteriye bağlı firmalar
model Firma {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String // firma unvanı
  vergiNo   String? // vergi numarası
  sektor    String? // sektör
  il        String? // il / şehir
  ilce      String?
  yetkiliAd String? // yetkili kişi
  telefon   String?
  email     String?
  adres     String?
  durum     String   @default("aktif") // "aktif" | "pasif"
  notlar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  yatirimlar  YatirimDestegi[]
  egitimler   Egitim[]
  hizmetler   Hizmet[]
  kisiler     Kisi[]
  firsatlar   Firsat[]
  aktiviteler Aktivite[]
  leadler     Lead[]
  teklifler   Teklif[]

  @@index([tenantId, ad])
  @@index([tenantId, il])
  @@index([tenantId, sektor])
  @@index([tenantId, durum])
  @@index([tenantId, createdAt])
}

// Firmalara verilen yatırım destekleri
model YatirimDestegi {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId    String
  firma      Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  baslik     String
  tur        String? // hibe, kredi, teşvik vb.
  tutar      Float    @default(0)
  paraBirimi String   @default("TRY")
  tarih      DateTime @default(now())
  durum      String   @default("basvuruldu") // basvuruldu | onaylandi | reddedildi | tamamlandi
  aciklama   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, tarih])
}

// Firmalara verilen eğitimler
model Egitim {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId   String
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  baslik    String
  konu      String?
  egitmen   String?
  tarih     DateTime @default(now())
  sureSaat  Float    @default(0)
  katilimci Int      @default(0)
  durum     String   @default("planlandi") // planlandi | tamamlandi | iptal
  notlar    String?
  createdAt DateTime @default(now())

  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, tarih])
}

// Firmalara sunulan hizmetler
model Hizmet {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId   String
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  baslik    String
  tur       String? // danışmanlık, denetim, raporlama vb.
  tarih     DateTime @default(now())
  durum     String   @default("devam") // devam | tamamlandi | iptal
  aciklama  String?
  createdAt DateTime @default(now())

  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, tarih])
}

// ── Faz 4: Yetkilendirme ve denetim ────────────────────────────────────────

// Kullanıcı grubu — bir kiracı içinde izinleri toplu atamak için.
// Etkin izin = rolün izinleri ∪ üye olunan grupların izinleri.
model Grup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  aciklama  String?
  izinler   String[] // "firma.duzenle" gibi izin anahtarları (src/lib/yetki.ts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uyeler KullaniciGrup[]

  @@unique([tenantId, ad])
  @@index([tenantId, ad])
}

// Kullanıcı ↔ grup üyeliği
model KullaniciGrup {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  grupId   String
  grup     Grup   @relation(fields: [grupId], references: [id], onDelete: Cascade)

  @@id([userId, grupId])
  @@index([tenantId, userId])
  @@index([tenantId, grupId])
}

// Denetim günlüğü — kim, ne zaman, hangi kaydı değiştirdi.
// Uygulama üzerinden DEĞİŞTİRİLEMEZ ve SİLİNEMEZ; yalnızca yazılır ve okunur.
model DenetimKaydi {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId    String?
  kullaniciEmail String // kullanıcı silinse bile kim olduğu kalsın
  islem          String // "olustur" | "guncelle" | "sil"
  varlik         String // "Firma" | "YatirimDestegi" | "Egitim" | "Hizmet" | "Grup" | "User"
  varlikId       String
  ozet           String? // insan okuyabilir kısa açıklama
  eski           Json? // değişiklik öncesi alanlar
  yeni           Json? // değişiklik sonrası alanlar
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, varlik, varlikId])
  @@index([tenantId, kullaniciId])
}

// ── Faz 5: Admin panel ─────────────────────────────────────────────────────

// Abonelik paketi — kiracı başına limitler ve açık modüller.
// Kiracıya ait DEĞİLDİR: platform genelinde tanımlanır, kiracılar atanır.
model Plan {
  id              String   @id @default(cuid())
  ad              String   @unique
  aciklama        String?
  kullaniciLimiti Int      @default(0) // 0 = sınırsız
  firmaLimiti     Int      @default(0) // 0 = sınırsız
  moduller        String[] // "firma" | "yatirim" | "egitim" | "hizmet" | "rapor"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kiracilar Tenant[]
}

// Kullanıcı daveti (B3) — e-posta ile gönderilen tek kullanımlık bağlantı.
// Token'ın kendisi saklanmaz; yalnızca özeti (hash) tutulur.
model Davet {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String
  ad             String
  rol            String    @default("uye")
  tokenOzeti     String    @unique // sha256(token)
  sonKullanma    DateTime
  kullanildi     DateTime?
  olusturanEmail String
  createdAt      DateTime  @default(now())

  @@index([tenantId, email])
  @@index([tenantId, createdAt])
}

// ── Faz 6: Satış çekirdeği ─────────────────────────────────────────────────

// Kişi (Contact) — firmadaki muhatap. Bir firmanın birden çok kişisi olur.
// `Firma.yetkiliAd` alanı Faz 6 migration'ında buraya taşındı; alan geriye
// dönük uyumluluk için duruyor ama arayüzde artık kişi kaydı kullanılır.
model Kisi {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId   String
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  ad        String
  unvan     String? // görev / pozisyon
  telefon   String?
  email     String?
  // Firmanın birincil muhatabı. Firma başına en fazla bir tane olur; kural
  // uygulama katmanında (kisiler/actions.ts) zorlanır.
  birincil  Boolean  @default(false)
  notlar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firsatlar   Firsat[]
  aktiviteler Aktivite[]

  @@index([tenantId, firmaId])
  @@index([tenantId, ad])
  @@index([tenantId, email])
}

// Satış hattı aşaması — KİRACIYA ÖZELDİR. Her kiracı kendi hattını kurar.
// `sira` kanban'daki soldan sağa sıralamayı verir.
model Asama {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  sira      Int      @default(0)
  olasilik  Int      @default(0) // %0-100, fırsata varsayılan olarak kopyalanır
  renk      String? // "#6366f1" — kanban sütun rengi
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firsatlar Firsat[]

  @@unique([tenantId, ad])
  @@index([tenantId, sira])
}

// Fırsat / Anlaşma (Deal) — satış hattındaki bir iş.
//
// `durum` ile `asamaId` bilinçli olarak AYRIDIR: aşama hattaki yeri, durum ise
// sonucu anlatır. Kazanılan/kaybedilen bir fırsat son aşamasında kalır ama
// kanban'ın açık sütunlarından düşer.
model Firsat {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firmaId       String
  firma         Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kisiId        String?
  kisi          Kisi?     @relation(fields: [kisiId], references: [id], onDelete: SetNull)
  asamaId       String
  asama         Asama     @relation(fields: [asamaId], references: [id], onDelete: Restrict)
  baslik        String
  tutar         Float     @default(0)
  paraBirimi    String    @default("TRY")
  olasilik      Int       @default(0) // %0-100
  kapanisTarihi DateTime?
  // Sorumlu kullanıcı. Kullanıcı silinirse fırsat sahipsiz kalır, silinmez.
  sorumluId     String?
  durum         String    @default("acik") // acik | kazanildi | kaybedildi
  kapanisSebebi String? // kaybedildiyse neden
  aciklama      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  aktiviteler Aktivite[]
  teklifler   Teklif[]

  @@index([tenantId, asamaId])
  @@index([tenantId, firmaId])
  @@index([tenantId, durum])
  @@index([tenantId, sorumluId])
  @@index([tenantId, kapanisTarihi])
}

// ── Faz 7: Satış derinleştirme ─────────────────────────────────────────────

// Aktivite / görev (C4) — arama, toplantı, not, görev, e-posta.
//
// Bilinçli olarak TEK model: "not" ile "görev" arasındaki fark bir alan
// (sonTarih/tamamlandi) meselesidir, ayrı tablo değil. Böylece firma
// timeline'ında (C6) tek sorguyla hepsi listelenir.
model Aktivite {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tur      String // arama | toplanti | not | gorev | eposta
  baslik   String
  aciklama String?

  // Bağlam — hepsi isteğe bağlıdır; bir aktivite yalnızca firmaya, ya da
  // firma + kişi + fırsata birden bağlanabilir.
  firmaId  String?
  firma    Firma?  @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kisiId   String?
  kisi     Kisi?   @relation(fields: [kisiId], references: [id], onDelete: SetNull)
  firsatId String?
  firsat   Firsat? @relation(fields: [firsatId], references: [id], onDelete: Cascade)

  // Görev alanları. `sonTarih` doluysa kayıt "yapılacak iş"tir.
  atananId   String?
  sonTarih   DateTime?
  tamamlandi DateTime? // doluysa tamamlanmış sayılır

  olusturanId    String?
  olusturanEmail String? // kullanıcı silinse de kimin girdiği kalsın
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, firmaId])
  @@index([tenantId, firsatId])
  @@index([tenantId, atananId, sonTarih])
  @@index([tenantId, createdAt])
}

// Aday müşteri / Lead (C5).
//
// Lead, HENÜZ firma olmamış bir ilgidir. Nitelendiğinde tek işlemle firma +
// kişi (+ isteğe bağlı fırsat) kayıtlarına dönüşür; dönüşen lead silinmez,
// nereye dönüştüğü `donusen*` alanlarında saklanır — kaynak takibi
// (hangi kanal ne kadar iş getirdi) bu bağa dayanır.
model Lead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ad       String // aday kişi
  firmaAd  String? // henüz sistemde firma kaydı yok, serbest metin
  unvan    String?
  email    String?
  telefon  String?
  il       String?
  sektor   String?
  kaynak   String? // web, fuar, referans, telefon, sosyal medya…
  durum    String  @default("yeni") // yeni | iletisim | nitelikli | donusturuldu | elendi
  notlar   String?
  atananId String?

  // Dönüşüm izleri (SetNull: hedef kayıt silinse de lead kalır)
  donusenFirmaId  String?
  donusenFirma    Firma?    @relation(fields: [donusenFirmaId], references: [id], onDelete: SetNull)
  donusenKisiId   String?
  donusenFirsatId String?
  donusumTarihi   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, durum])
  @@index([tenantId, kaynak])
  @@index([tenantId, atananId])
  @@index([tenantId, createdAt])
}

// Teklif (C7) — fırsata bağlı, kalemli, revizyonlu.
//
// Revizyon yeni bir Teklif satırıdır ve `ustTeklifId` ile aslına bağlanır;
// eski sürüm DEĞİŞTİRİLMEZ. Gönderilmiş bir teklifin üzerine yazmak, "hangi
// rakamı görüştük?" sorusunu yanıtsız bırakırdı.
model Teklif {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firmaId  String
  firma    Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firsatId String?
  firsat   Firsat? @relation(fields: [firsatId], references: [id], onDelete: SetNull)
  kisiId   String?

  no     String // kiracı içinde benzersiz teklif numarası
  baslik String
  durum  String @default("taslak") // taslak | gonderildi | kabul | red | revizyon

  paraBirimi    String @default("TRY")
  indirimOrani  Float  @default(0) // % — ara toplam üzerinden
  kdvOrani      Float  @default(20) // %
  araToplam     Float  @default(0) // kalem toplamı (hesaplanır, saklanır)
  indirimTutari Float  @default(0)
  kdvTutari     Float  @default(0)
  toplam        Float  @default(0)

  gecerlilikTarihi DateTime?
  gonderimTarihi   DateTime?
  notlar           String?
  sartlar          String?

  // Revizyon zinciri
  revizyonNo  Int      @default(1)
  ustTeklifId String?
  ustTeklif   Teklif?  @relation("TeklifRevizyon", fields: [ustTeklifId], references: [id], onDelete: SetNull)
  revizyonlar Teklif[] @relation("TeklifRevizyon")

  olusturanEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kalemler TeklifKalemi[]

  @@unique([tenantId, no])
  @@index([tenantId, firmaId])
  @@index([tenantId, firsatId])
  @@index([tenantId, durum])
  @@index([tenantId, createdAt])
}

// Teklif kalemi — satır bazlı tutar. Teklifle birlikte silinir.
model TeklifKalemi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teklifId String
  teklif   Teklif @relation(fields: [teklifId], references: [id], onDelete: Cascade)

  sira       Int    @default(0)
  aciklama   String
  miktar     Float  @default(1)
  birim      String @default("adet")
  birimFiyat Float  @default(0)
  tutar      Float  @default(0) // miktar × birimFiyat (hesaplanır, saklanır)

  @@index([tenantId, teklifId])
}

// ── Faz 8: Bildirim, otomasyon, e-posta, takvim ────────────────────────────

// Uygulama içi bildirim (D5).
//
// E-postadan AYRI tutulur: e-posta gönderilemese bile (SMTP tanımsız, sunucu
// erişilemez) kullanıcı olan biteni panelde görebilmelidir.
model Bildirim {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId String // bildirimin sahibi

  tur    String // gorev.atandi | gorev.yaklasti | firsat.asama | teklif.durum | ...
  baslik String
  mesaj  String?
  link   String? // tıklanınca gidilecek yol

  okundu    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, kullaniciId, okundu])
  @@index([tenantId, createdAt])
}

// Kullanıcı bildirim tercihi (D1).
//
// Kayıt YOKSA varsayılan geçerlidir (uygulama içi açık, e-posta açık); yani
// tercih tablosu yalnızca "varsayılandan sapma"yı tutar. Yeni bir bildirim
// türü eklendiğinde herkes için satır açmak gerekmez.
model BildirimTercihi {
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kullaniciId String
  tur         String // bildirim türü anahtarı
  uygulama    Boolean @default(true)
  eposta      Boolean @default(true)

  @@id([kullaniciId, tur])
  @@index([tenantId, kullaniciId])
}

// Kiracının e-posta ayarları (D1 gönderim, D3 gelen kutusu).
//
// Parolalar AES-256-GCM ile şifreli saklanır (`src/lib/sifreleme.ts`);
// veritabanını okuyan biri müşterinin posta kutusuna erişememelidir.
model EpostaAyari {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Giden (SMTP)
  smtpHost      String?
  smtpPort      Int     @default(587)
  smtpGuvenli   Boolean @default(false) // true = 465/SSL, false = STARTTLS
  smtpKullanici String?
  smtpParola    String? // şifreli
  gonderenAd    String?
  gonderenAdres String?

  // Gelen (IMAP)
  imapHost      String?
  imapPort      Int       @default(993)
  imapKullanici String?
  imapParola    String? // şifreli
  imapKlasor    String    @default("INBOX")
  sonSenkron    DateTime?
  sonHata       String?

  aktif     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Giden e-posta kuyruğu ve kaydı (D1).
//
// Gönderim ANINDA denenmez: kayıt yazılır, zamanlanmış çalıştırıcı gönderir.
// Böylece SMTP yavaş ya da erişilemez olduğunda kullanıcının işlemi
// beklemez ve başarısız gönderim yeniden denenebilir.
model EpostaKuyrugu {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  alici String
  konu  String
  govde String
  tur   String? // hangi bildirim türünden doğdu

  durum          String    @default("bekliyor") // bekliyor | gonderildi | hata
  denemeSayisi   Int       @default(0)
  hata           String?
  gonderimZamani DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, durum])
  @@index([tenantId, createdAt])
}

// Senkronize edilen gelen e-posta (D3).
//
// Mesajın kendisi değil, ÖZETİ saklanır: kim, ne zaman, hangi konu. Gövde
// yalnızca ilgili kayda düşen aktivitede özet olarak durur. Amaç posta
// istemcisi olmak değil, yazışmanın CRM'de izini bırakmak.
model EpostaKaydi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mesajId  String // IMAP Message-ID — aynı posta iki kez işlenmesin
  yon      String   @default("gelen") // gelen | giden
  gonderen String
  alici    String
  konu     String
  ozet     String?
  tarih    DateTime

  // Eşleşme (bulunabildiyse)
  firmaId String?
  kisiId  String?

  createdAt DateTime @default(now())

  @@unique([tenantId, mesajId])
  @@index([tenantId, tarih])
  @@index([tenantId, firmaId])
}

// İş akışı kuralı (D2).
//
// "Tetikleyici olduğunda şu eylemleri yap." Kural KİRACIYA ÖZELDİR.
// Koşullar ve eylemler JSON olarak saklanır; her kural tipi için ayrı sütun
// açmak, yeni tetikleyici eklendiğinde şema değişikliği gerektirirdi.
model IsAkisi {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ad       String
  aciklama String?
  aktif    Boolean @default(true)

  tetikleyici String // firsat.asamaDegisti | gorev.yaklasti | teklif.durumDegisti | firsat.beklemede
  kosullar    Json? // { asamaId, gunSayisi, durum, ... }
  eylemler    Json // [{ tur: "bildirim"|"eposta"|"gorev", ... }]

  sonCalisma    DateTime?
  calismaSayisi Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calismalar IsAkisiCalismasi[]

  @@unique([tenantId, ad])
  @@index([tenantId, aktif])
}

// İş akışı çalışma kaydı (D2) — neyin neden tetiklendiğinin izi.
model IsAkisiCalismasi {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isAkisiId String
  isAkisi   IsAkisi @relation(fields: [isAkisiId], references: [id], onDelete: Cascade)

  hedefTur  String? // Firsat | Aktivite | Teklif
  hedefId   String?
  sonuc     String // basarili | hata
  ozet      String?
  createdAt DateTime @default(now())

  @@index([tenantId, isAkisiId, createdAt])
}
